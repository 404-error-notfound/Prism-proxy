# proxy-hub 服务器配置（复制为 .env 使用）
# 与 prism 共用生产 Redis 集群（key 前缀 proxyhub: 与 prism 的 prism: 隔离）
PROXY_HUB_REDIS_URL=redis://localhost:6379
PROXY_HUB_REDIS_PASSWORD=
PROXY_HUB_REDIS_CLUSTER_MODE=true
PROXY_HUB_REDIS_KEY_PREFIX=proxyhub:

# Admin API Bearer token（PUT /admin/config 热配置用）
PROXY_HUB_ADMIN_TOKEN=

# qg.net 提取 API（1min 短效套餐；num 会被滚动补位按缺口重写，填目标池大小上限即可）
PROXY_HUB_PROVIDER_API_URL=https://share.proxy.qg.net/get?key=<KEY>&num=6&distinct=true
# 账密留空 = 走 IP 白名单（服务器出网 IP 已在 qg.net 后台加白）
PROXY_HUB_PROVIDER_AUTH_KEY=
PROXY_HUB_PROVIDER_AUTH_PWD=
# IP 有效期兜底（秒）：仅供应商响应缺 deadline 时用；正常以每个 IP 的 deadline 为准，
# 换套餐（1min/2min/5min）不用改这里
PROXY_HUB_IP_TTL_FALLBACK_S=60

# 青果独享代理（可选；配了才启用，pool_type=exclusive 的项目池按 target 路由使用）。
# 基址 https://exclusive.proxy.qg.net，接口 /get /query /delete /replace（doc/1843）
# API 链接：直接填控制台"独享代理(地区锁)"产品页生成的完整提取链接
# （.../get?key=...），provider 会剥掉端点名得到基址；填裸基址也可以
PROXY_HUB_EXCLUSIVE_API_URL=
# 注意：这是**代理建连账密**（控制台"代理验证-账密"，独享代理不带账密建连 407），
# 不是 API key——API 鉴权的 key= 已含在上面链接里
PROXY_HUB_EXCLUSIVE_AUTH_KEY=
PROXY_HUB_EXCLUSIVE_AUTH_PWD=
# 独享 IP 默认租期（秒）：仅提取响应缺到期时间字段时用，正常以响应的 deadline 为准
# PROXY_HUB_EXCLUSIVE_DEFAULT_TTL_S=86400
# 独享池体检探针（轻量中立连通性探测，204 无反爬）：独享 IP 7×24 被反复打搜索引擎
# 探测页等于主动烧自己；独享池体检禁 slow-as-dead（慢≠死），判死轮数比共享池多 1 轮
# PROXY_HUB_EXCLUSIVE_HEALTH_URL=https://connect.rom.miui.com/generate_204

# 隧道模式：proxy-hub 自建 HTTP 转发代理监听端口（消费方代理指向
# http://<项目名>:<项目token>@<本机IP>:8101，项目先经 POST /admin/projects 注册）。
# 0 = 纯 pull 模式
PROXY_HUB_FORWARD_PORT=8101
PROXY_HUB_FORWARD_MAX_CONNS=512

# 健康探测目标（bing 三态；勿换百度，会全误杀）
PROXY_HUB_HEALTH_CHECK_URL=https://cn.bing.com/search?q=新闻
PROXY_HUB_HEALTH_CHECK_MARKERS=id="b_results",class="b_algo"
PROXY_HUB_HEALTH_CHECK_TIMEOUT_S=4.0

# 时段表/三档参数/自适应阈值/判死轮数/下发禁区(alloc_min_ttl_s, 默认 25s)/
# 城市级自动换段(auto_area_exclude_*, 默认开：某城市 10min 内 ≥3 个 IP 被风控
# → 提取时动态 area_ex 排除, 4h 后自动放回)/
# 独享池(exclusive_targets=["baidu","quark"] 按 target 路由名单, 空=关闭;
# exclusive_replace_cooldown_s=60 更换冷却, exclusive_per_ip_qps=0.2
# 每 IP 限速)走热配置（PUT /admin/config），不做 env。
# 默认：全天 normal（巡检 15s、目标池大小 4）；需要低谷降本时下发：
#   {"schedule":"peak=08:00-22:00,offpeak=22:00-08:00"}

# ES 日志落库（生产/测试服都建议开，排查问题主要靠它）
PROXY_HUB_LOG_ES_ENABLED=true
PROXY_HUB_LOG_ES_URL=http://localhost:9200
PROXY_HUB_LOG_ES_INDEX=proxyhub_logs
PROXY_HUB_LOG_ES_MIN_LEVEL=INFO
# ES 集群账密（开了安全认证的集群必填）
PROXY_HUB_LOG_ES_USER=elastic
PROXY_HUB_LOG_ES_PASSWORD=

# ── 进阶旋钮（一般用默认值即可，按需取消注释）──
# PROXY_HUB_HOST=0.0.0.0                  # 监听地址
# PROXY_HUB_PORT=8100                     # 控制面端口
# PROXY_HUB_LOG_LEVEL=INFO
# PROXY_HUB_APP_ENV=dev                   # prod 时 stdout 也是 JSON
# PROXY_HUB_PROVIDER=qgnet                # 供应商插件名
# PROXY_HUB_PROVIDER_API_TIMEOUT_S=10.0   # 供应商 API 超时
# PROXY_HUB_FAIL_COOLDOWN_S=15.0          # 供应商故障冷却（跨副本生效）
# PROXY_HUB_REFRESH_LOCK_TTL_S=60         # 刷新锁 TTL（主副本宕机后的补位时延上限）
# PROXY_HUB_HEALTH_MIN_BODY_BYTES=20000   # 探测判"能搜索"的响应体下限
# PROXY_HUB_HEALTH_MAX_LATENCY_S=2.0      # 体检延迟门槛：慢于此值的 IP 按死处理
                                          # （对齐转发层 2s connect 预算，0=不启用）
# PROXY_HUB_HEALTH_USER_AGENT=...         # 探测 UA（默认真实 Chrome UA）
# PROXY_HUB_LOG_ES_BATCH_SIZE=100         # ES 日志批量大小
# PROXY_HUB_LOG_ES_FLUSH_INTERVAL_S=5.0   # ES 日志最长刷写间隔
